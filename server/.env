# ============ 数据库配置 ============
DB_HOST='localhost'           # 数据库主机地址
DB_USER='root'                # 数据库用户名
DB_PASSWORD='123456'          # 数据库密码
DB_NAME='blogserver'          # 数据库名

# ============ JWT 配置 ============
# 用于签发/校验登录 Token 的密钥，上线前务必改成随机长字符串
JWT_SECRET='person_blog_jwt_secret_2026'

# ============ SMTP 邮件配置 ============
# 不配置以下字段时，验证码邮件将降级为“仅输出到控制台”；配置完整后走真实发送
SMTP_HOST='smtp.163.com'      # SMTP 服务器地址（163 邮箱：smtp.163.com）
SMTP_PORT='465'               # 端口，465 为 SSL 加密端口（587 为 STARTTLS）
SMTP_USER='15908575332@163.com'  # 发件邮箱账号
SMTP_PASS='KLbFARqVYTPdsX5x'  # 授权码：邮箱开启 SMTP 服务生成的客户端授权密码（非登录密码）
